# Chave de API da NVIDIA NIM (Minimax)
NVIDIA_API_KEY=

# Chave de API do Google Gemini (gemini-3.8-flash)
GEMINI_API_KEY=

# Token de autenticação da API do Milvus
MILVUS_API_TOKEN=

# URL base da API do Milvus
MILVUS_BASE_URL=https://apiintegracao.milvus.com.br/api

# Rate limit estrito da API do Milvus em segundos (1 req/minuto + 2s de margem de segurança)
MILVUS_RATE_LIMIT_SECONDS=62
