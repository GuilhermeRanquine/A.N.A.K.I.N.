# Chave de API da NVIDIA NIM (Minimax)
NVIDIA_API_KEY=

# Chave e modelo do Google Gemini (gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Token de autenticação da API do Milvus
MILVUS_API_TOKEN=

# URL base da API do Milvus
MILVUS_BASE_URL=https://apiintegracao.milvus.com.br/api

# Rate limit estrito da API do Milvus em segundos (1 req/minuto + 2s de margem de segurança)
MILVUS_RATE_LIMIT_SECONDS=62

# Pesos do Algoritmo de Fila Ponderada por Carga (Score de Ocupação)
PESO_STATUS_ATENDENDO=3
PESO_STATUS_A_FAZER=2
PESO_STATUS_PAUSADO=1
PESO_STATUS_OUTROS=1
