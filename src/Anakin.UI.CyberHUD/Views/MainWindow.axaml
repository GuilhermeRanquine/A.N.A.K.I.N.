<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anakin.UI.CyberHUD.ViewModels"
        xmlns:controls="using:Anakin.UI.CyberHUD.Controls"
        x:Class="Anakin.UI.CyberHUD.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="A.N.A.K.I.N // TACTICAL CYBERHUD v2.0"
        Width="1600" Height="920"
        MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#030305">

    <Window.Styles>
        <!-- Estilo base dos botões táticos -->
        <Style Selector="Button.cyber-btn">
            <Setter Property="FontFamily" Value="Consolas, 'Cascadia Code', monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#0B0E14" />
            <Setter Property="Foreground" Value="#00F3FF" />
            <Setter Property="BorderBrush" Value="#00F3FF88" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cyber-btn:hover">
            <Setter Property="Background" Value="#00F3FF22" />
            <Setter Property="BorderBrush" Value="#00F3FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.cyber-primary">
            <Setter Property="Background" Value="#00F3FF" />
            <Setter Property="Foreground" Value="#030305" />
            <Setter Property="BorderBrush" Value="#00F3FF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.cyber-primary:hover">
            <Setter Property="Background" Value="#00FFA3" />
            <Setter Property="BorderBrush" Value="#00FFA3" />
            <Setter Property="Foreground" Value="#030305" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="14">
        <!-- 1. BARRA SUPERIOR HOLOGRÁFICA // TICKER TÁTICO -->
        <Border Grid.Row="0" Background="#07090E" BorderBrush="#162030" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Cluster de Marca -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#00F3FF22" BorderBrush="#00F3FF" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <TextBlock Text="A.N.A.K.I.N" Foreground="#00F3FF" FontWeight="Bold" FontSize="14" LetterSpacing="2" />
                    </Border>
                    <TextBlock Text="//" Foreground="#3A4D66" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="OPERATIONAL CYBERHUD CONSOLE" Foreground="#E0E6ED" FontSize="12" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center" />
                    <Border Background="#00FFA318" BorderBrush="#00FFA388" BorderThickness="1" CornerRadius="3" Padding="6,2">
                        <TextBlock Text="{Binding StatusMotor}" Foreground="#00FFA3" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Ticker Central com Countdown Milvus -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#00F3FF" VerticalAlignment="Center" />
                        <TextBlock Text="MILVUS: READ-ONLY LOCK" Foreground="#8A99AD" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#00FFA3" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CountdownMilvus}" Foreground="#00FFA3" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#FF9A3C" VerticalAlignment="Center" />
                        <TextBlock Text="DISPATCH ALGORITHM: PONDERED LOAD" Foreground="#8A99AD" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Relógio Digital Tático -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DataTatica}" Foreground="#5A6E85" FontSize="9" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RelogioTatico}" Foreground="#00F3FF" FontWeight="Bold" FontSize="16" FontFamily="Consolas, monospace" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Classes="cyber-btn" Command="{Binding RecarregarDadosDuckDbAsyncCommand}" Padding="8,4">
                        ◈ REFRESH
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. RACK DE KPIS (6 CARDS METRICOS) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *, *, 1.4*" Margin="0,0,0,10">
            <!-- KPI 1: TOTAL ATIVOS -->
            <Border Grid.Column="0" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="CHAMADOS ATIVOS" Foreground="#8A99AD" FontSize="9" LetterSpacing="1" />
                    <TextBlock Text="{Binding KpiTotalAtivos}" Foreground="#00F3FF" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- KPI 2: A FAZER -->
            <Border Grid.Column="1" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="A FAZER (PENDENTES)" Foreground="#8A99AD" FontSize="9" LetterSpacing="1" />
                    <TextBlock Text="{Binding KpiAFazer}" Foreground="#FF9A3C" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- KPI 3: ATENDENDO -->
            <Border Grid.Column="2" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="EM ATENDIMENTO" Foreground="#8A99AD" FontSize="9" LetterSpacing="1" />
                    <TextBlock Text="{Binding KpiAtendendo}" Foreground="#00FFA3" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- KPI 4: PAUSADOS -->
            <Border Grid.Column="3" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="PAUSADOS / AGUARDANDO" Foreground="#8A99AD" FontSize="9" LetterSpacing="1" />
                    <TextBlock Text="{Binding KpiPausados}" Foreground="#A78BFA" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- KPI 5: CARGA MÉDIA -->
            <Border Grid.Column="4" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="CARGA MÉDIA EQUIPE" Foreground="#8A99AD" FontSize="9" LetterSpacing="1" />
                    <TextBlock Text="{Binding KpiScoreMedio}" Foreground="#00F3FF" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <!-- KPI 6: PRÓXIMO RECOMENDADO -->
            <Border Grid.Column="5" Background="#07090E" BorderBrush="#00FFA355" BorderThickness="1" CornerRadius="3" Padding="10,6">
                <StackPanel Spacing="2">
                    <TextBlock Text="PRÓXIMO ALVO DE ATRIBUIÇÃO" Foreground="#00FFA3" FontSize="9" FontWeight="Bold" LetterSpacing="1" />
                    <TextBlock Text="{Binding ProximoRecomendado}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. GRADE PRINCIPAL TÁTICA (3 COLUNAS) -->
        <Grid Grid.Row="2" ColumnDefinitions="360, *, 380" Margin="0,0,0,10">
            <!-- COLUNA 1: FROTA DE OPERADORES EM TEMPO REAL -->
            <Border Grid.Column="0" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="◈ FROTA DE OPERADORES (MILVUS)" Foreground="#00F3FF" FontWeight="Bold" FontSize="11" LetterSpacing="1" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#00F3FF18" BorderBrush="#00F3FF44" BorderThickness="1" CornerRadius="2" Padding="4,2">
                            <TextBlock Text="{Binding Operadores.Count, StringFormat='ATIVOS: {0}'}" Foreground="#00F3FF" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <ListBox ItemsSource="{Binding Operadores}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B0E14" BorderBrush="#162030" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto, Auto, Auto">
                                        <!-- Linha 1: Nome, Tier e Score -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                            <Border Grid.Column="0" Background="#00F3FF22" BorderBrush="#00F3FF66" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Tier}" Foreground="#00F3FF" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nome}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2" Background="#07090E" BorderBrush="{Binding ScoreCor}" BorderThickness="1" CornerRadius="2" Padding="6,2">
                                                <TextBlock Text="{Binding ScoreCargaAtual, StringFormat='Score: {0}'}" Foreground="{Binding ScoreCor}" FontWeight="Bold" FontSize="10" />
                                            </Border>
                                        </Grid>

                                        <!-- Linha 2: E-mail -->
                                        <TextBlock Grid.Row="1" Text="{Binding Email}" Foreground="#6B7C93" FontSize="10" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

                                        <!-- Linha 3: Barra de Carga e Contadores -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                            <ProgressBar Grid.Column="0" Value="{Binding PercentualCarga}" Minimum="0" Maximum="1" Height="4" Margin="0,0,8,0" Foreground="{Binding ScoreCor}" Background="#121824" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ChamadosAtendendo, StringFormat='At: {0}'}" Foreground="#00FFA3" FontSize="9" />
                                                <TextBlock Text="{Binding ChamadosAFazer, StringFormat='Fz: {0}'}" Foreground="#FF9A3C" FontSize="9" />
                                                <TextBlock Text="{Binding ChamadosPausados, StringFormat='Ps: {0}'}" Foreground="#8A99AD" FontSize="9" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- COLUNA 2: RADAR DE INCIDENTES // FILA DE DESPACHO -->
            <Border Grid.Column="1" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <DockPanel>
                    <!-- Barra de Ações e Filtros de Chamados -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="◈ RADAR DE INCIDENTES REAIS" Foreground="#00F3FF" FontWeight="Bold" FontSize="11" LetterSpacing="1" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Classes="cyber-btn" Command="{Binding DefinirFiltroCommand}" CommandParameter="TODOS" Padding="6,2" FontSize="9">
                                TODOS
                            </Button>
                            <Button Classes="cyber-btn" Command="{Binding DefinirFiltroCommand}" CommandParameter="A_FAZER" Padding="6,2" FontSize="9" Foreground="#FF9A3C">
                                A FAZER
                            </Button>
                            <Button Classes="cyber-btn" Command="{Binding DefinirFiltroCommand}" CommandParameter="ATENDENDO" Padding="6,2" FontSize="9" Foreground="#00FFA3">
                                ATENDENDO
                            </Button>
                            <Button Classes="cyber-btn" Command="{Binding DefinirFiltroCommand}" CommandParameter="PAUSADOS" Padding="6,2" FontSize="9" Foreground="#A78BFA">
                                PAUSADOS
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="2" Classes="cyber-btn cyber-primary" Command="{Binding DespacharProximoChamadoCommand}" Padding="14,6">
                            ⚡ DISPARAR DESPACHO PONDERADO
                        </Button>
                    </Grid>

                    <ListBox ItemsSource="{Binding FilaChamados}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B0E14" BorderBrush="#162030" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,6">
                                    <Grid RowDefinitions="Auto, Auto, Auto">
                                        <!-- Topo: Código, Prioridade, Status e SLA -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding CodigoFormatado}" Foreground="#00F3FF" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Background="#07090E" BorderBrush="{Binding PrioridadeCor}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Prioridade}" Foreground="{Binding PrioridadeCor}" FontWeight="Bold" FontSize="9" />
                                            </Border>
                                            <Border Grid.Column="2" HorizontalAlignment="Left" Background="#07090E" BorderBrush="{Binding StatusCor}" BorderThickness="1" CornerRadius="2" Padding="5,1">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusCor}" FontSize="9" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding DataCriacao}" Foreground="#5A6E85" FontSize="9" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Meio: Cliente e Assunto -->
                                        <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Cliente}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Titulo}" Foreground="#C5D1DE" FontSize="11" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>

                                        <!-- Rodapé: Categoria e Operador Atribuído -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Border Background="#121824" CornerRadius="2" Padding="4,2">
                                                    <TextBlock Text="{Binding Categoria, StringFormat='Cat: {0}'}" Foreground="#8A99AD" FontSize="9" />
                                                </Border>
                                                <TextBlock Text="{Binding OperadorNome, StringFormat='👤 {0}'}" Foreground="#00FFA3" FontSize="9" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SlaStatus}" Foreground="#8A99AD" FontSize="9" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- COLUNA 3: OSCILOSCÓPIO TÁTICO & TELEMETRIA -->
            <Border Grid.Column="2" Background="#07090E" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="4" Padding="10">
                <DockPanel>
                    <!-- Título da Seção -->
                    <TextBlock DockPanel.Dock="Top" Text="◈ OSCILOSCÓPIO &amp; AUDITORIA TÁTICA" Foreground="#00F3FF" FontWeight="Bold" FontSize="11" LetterSpacing="1" Margin="0,0,0,8" />

                    <!-- Box do Osciloscópio Holográfico Animado (GPU Skia) -->
                    <Border DockPanel.Dock="Top" Background="#05070A" BorderBrush="#00F3FF44" BorderThickness="1" CornerRadius="3" Height="140" Margin="0,0,0,8">
                        <Grid>
                            <controls:TacticalWaveformControl />
                            <!-- Labels táticos sobrepostos na onda -->
                            <StackPanel Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="VOZ GEMINI LIVE API // AUDIO CORE" Foreground="#00F3FF" FontSize="8" FontWeight="Bold" />
                                <TextBlock Text="WSS 24kHz PCM STREAM" Foreground="#8A99AD" FontSize="8" />
                            </StackPanel>
                            <Border Margin="8" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#00FFA318" BorderBrush="#00FFA388" BorderThickness="1" CornerRadius="2" Padding="4,1">
                                <TextBlock Text="60 FPS GPU SKIA" Foreground="#00FFA3" FontSize="8" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Status de Prontidão da Voz -->
                    <Border DockPanel.Dock="Top" Background="#0B0E14" BorderBrush="#1A2638" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="TELEMETRIA DO SEGUNDO CÉREBRO" Foreground="#00FFA3" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="TOOL CALLING ATIVO" Foreground="#00F3FF" FontSize="8" />
                            </Grid>
                            <TextBlock Text="{Binding StatusGeminiLive}" Foreground="#C5D1DE" FontSize="9" />
                            <TextBlock Text="Tools: ConsultarStatusChamado, DespacharChamado" Foreground="#6B7C93" FontSize="8" />
                        </StackPanel>
                    </Border>

                    <!-- Console de Logs de Auditoria -->
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="CONSOLE DE EVENTOS" Foreground="#8A99AD" FontSize="9" />
                            <Button Grid.Column="1" Command="{Binding LimparLogsCommand}" Background="Transparent" Foreground="#6B7C93" FontSize="9" Padding="2,0">
                                LIMPAR
                            </Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding LogsOperacionais}" Background="#05070A" BorderBrush="#121824" BorderThickness="1" CornerRadius="3">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#00FFA3" FontSize="10" FontFamily="Consolas, monospace" Margin="4,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 4. RODAPÉ TÁTICO HOLOGRÁFICO -->
        <Border Grid.Row="3" Background="#07090E" BorderBrush="#162030" BorderThickness="1" CornerRadius="3" Padding="10,6">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="A.N.A.K.I.N SYSTEM CORE // .NET 9.0 LTS // C# 13 // AVALONIA UI GPU SKIA // DUCKDB.NET // POLLY v8 // NAUDIO" Foreground="#5A6E85" FontSize="9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="ZERO-ALLOCATION IN HOT PATHS // RESILIENCE SECURED // AUDIT COMPLIANT" Foreground="#00FFA3" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
